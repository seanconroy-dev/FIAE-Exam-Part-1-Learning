---
import Base from '../../layouts/Base.astro';
import { getAllCards, getAllModules, moduleSlug } from '../../lib/cards';

const cards = await getAllCards();
const modules = await getAllModules();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const apiBase = import.meta.env.PUBLIC_API_BASE;
const moduleKeyMap = Object.fromEntries(modules.map((moduleName) => [moduleName, moduleSlug(moduleName)]));

// Pass card data to client-side JS
const cardData = cards.map(c => ({
  id: c.id,
  slug: c.slug,
  title: c.title,
  module: c.module,
  tags: c.tags,
  question: c.card.question,
  image: c.card.image ?? null,
  answer: c.card.answer,
  answerImage: c.card.answerImage ?? null,
  examples: c.card.examples ?? [],
  type: c.card.type,
}));
---
<Base title="Quiz – FIAE Exam 1">
  <div class="max-w-2xl lg:max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold text-gray-900 shrink-0">Quiz</h1>
      <select id="quiz-module" class="flex-1 min-w-0 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">Alle Module</option>
        {modules.map(m => <option value={m}>{m}</option>)}
      </select>
      <button id="btn-start" class="shrink-0 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition-colors">
        Starten
      </button>
    </div>
    <p id="sync-status" class="text-sm text-gray-500">
      Ohne API-Key läuft das Quiz lokal ohne Fortschrittssynchronisierung.
    </p>

    <!-- Progress bar -->
    <div id="progress-wrap" class="hidden">
      <div class="flex justify-between text-xs text-gray-500 mb-1">
        <span id="progress-text">Karte 1 von 0</span>
        <span id="score-text">✅ 0 · ❌ 0</span>
      </div>
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-blue-500 transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <!-- Flashcard -->
    <div id="card-wrap" class="hidden">
      <div
        id="flip-card"
        class="relative cursor-pointer"
        style="perspective: 1000px; height: clamp(340px, 55vh, 700px);"
        title="Klicken zum Aufdecken"
      >
        <div
          id="card-inner"
          class="relative w-full transition-transform duration-400"
          style="transform-style: preserve-3d; height: 100%;"
        >
          <!-- Front -->
          <div
            class="absolute inset-0 bg-white border-2 border-blue-200 rounded-2xl p-4 md:p-8 flex flex-col shadow-md"
            style="backface-visibility: hidden;"
          >
            <div class="text-xs uppercase tracking-wider text-blue-500 font-semibold text-center">Frage</div>
            <div class="flex-1 min-h-0 flex flex-col items-center justify-center text-center overflow-y-auto">
              <div id="card-question" class="text-base sm:text-lg lg:text-2xl font-semibold text-gray-800 leading-relaxed w-full text-left"></div>
              <img id="card-image" class="hidden mt-4 max-h-32 mx-auto rounded-lg object-contain" alt="" />
            </div>
            <div class="text-center text-sm text-blue-300">Klicken zum Aufdecken →</div>
          </div>
          <!-- Back -->
          <div
            class="absolute inset-0 bg-white border-2 border-green-200 rounded-2xl p-4 md:p-8 flex flex-col shadow-md"
            style="backface-visibility: hidden; transform: rotateY(180deg);"
          >
            <div class="text-xs uppercase tracking-wider text-green-500 font-semibold text-center">Antwort</div>
            <div class="flex-1 min-h-0 flex flex-col items-center justify-start text-center overflow-y-auto">
              <div id="card-answer" class="text-base sm:text-lg lg:text-2xl text-gray-800 leading-relaxed w-full text-left"></div>
              <img id="card-answer-image" class="hidden mt-4 max-h-32 mx-auto rounded-lg object-contain" alt="" />
              <div id="card-examples" class="mt-4 hidden w-full text-left">
                <div class="text-xs uppercase tracking-wider text-gray-600 font-semibold mb-2">Beispiele</div>
                <ul id="card-examples-list" class="text-base text-gray-600 space-y-1 list-disc list-inside"></ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Rating buttons (shown after flip) -->
      <div id="rating-buttons" class="hidden flex gap-3 mt-4">
        <button id="btn-wrong" class="flex-1 bg-red-100 hover:bg-red-200 text-red-700 font-semibold py-3 rounded-xl text-sm transition-colors border border-red-200">
          ❌ Nochmal
        </button>
        <button id="btn-correct" class="flex-1 bg-green-100 hover:bg-green-200 text-green-700 font-semibold py-3 rounded-xl text-sm transition-colors border border-green-200">
          ✅ Gewusst
        </button>
      </div>
    </div>

    <!-- Finished screen -->
    <div id="finish-wrap" class="hidden text-center space-y-4 py-10">
      <div class="text-6xl">🎉</div>
      <h2 class="text-2xl font-bold text-gray-900">Runde abgeschlossen!</h2>
      <p id="finish-score" class="text-gray-600"></p>
      <div class="flex justify-center gap-3 mt-4">
        <button id="btn-retry-wrong" class="bg-red-100 hover:bg-red-200 text-red-700 font-semibold px-5 py-2.5 rounded-xl text-sm transition-colors border border-red-200">
          Falsche wiederholen
        </button>
        <button id="btn-restart" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm transition-colors">
          Neu starten
        </button>
      </div>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="text-center text-gray-400 py-16">
      Wähle ein Modul und starte das Quiz.
    </div>
  </div>
</Base>

<script define:vars={{ cardData, base, apiBase, moduleKeyMap }}>
  import {
    ALL_MODULE_KEY,
    buildHistoricalAnswerBody,
    clearResetTombstone,
    compareSnapshots,
    createNewSnapshot,
    deriveScore,
    hasPendingResetTombstone,
    loadStore,
    markResetTombstone,
    recordAnswer,
    removeModuleSnapshot,
    restoreQueueFromSlugs,
    sanitizeStore,
    saveStore,
    setModuleSnapshot,
    validateSnapshotAgainstCards,
  } from '../../lib/quiz-state';

  // Simple markdown bold/italic renderer for answer text
  function renderMd(text) {
    return text
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`(.+?)`/g, '<code class="bg-gray-100 text-red-600 rounded px-1 text-xs">$1</code>')
      .split('\n')
      .map(line => {
        if (line.startsWith('- ')) return `<li class="ml-4 list-disc">${line.slice(2)}</li>`;
        if (line.startsWith('**') && line.endsWith('**')) return `<strong>${line.slice(2, -2)}</strong>`;
        return line;
      })
      .join('\n')
      .replace(/(<li.*<\/li>\n?)+/g, m => `<ul class="space-y-1 list-disc list-inside">${m}</ul>`);
  }

  function nowIso() {
    return new Date().toISOString();
  }

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  let flipped = false;
  let backendReachable = false;
  let authMode = window.fiaeAuth?.hasApiKey() ? 'unknown' : 'none';
  let store;
  let activeSnapshot = null;
  let activeQueue = [];
  const inFlightSyncRevisions = new Set();
  const availableSlugs = new Set(cardData.map(card => card.slug));

  const quizModule = document.getElementById('quiz-module');
  const btnStart = document.getElementById('btn-start');
  const progressWrap = document.getElementById('progress-wrap');
  const progressText = document.getElementById('progress-text');
  const scoreText = document.getElementById('score-text');
  const progressBar = document.getElementById('progress-bar');
  const cardWrap = document.getElementById('card-wrap');
  const flipCard = document.getElementById('flip-card');
  const cardInner = document.getElementById('card-inner');
  const cardQuestion = document.getElementById('card-question');
  const cardImage = document.getElementById('card-image');
  const cardAnswer = document.getElementById('card-answer');
  const cardAnswerImage = document.getElementById('card-answer-image');
  const cardExamples = document.getElementById('card-examples');
  const cardExamplesList = document.getElementById('card-examples-list');
  const ratingButtons = document.getElementById('rating-buttons');
  const btnWrong = document.getElementById('btn-wrong');
  const btnCorrect = document.getElementById('btn-correct');
  const finishWrap = document.getElementById('finish-wrap');
  const finishScore = document.getElementById('finish-score');
  const btnRetryWrong = document.getElementById('btn-retry-wrong');
  const btnRestart = document.getElementById('btn-restart');
  const emptyState = document.getElementById('empty-state');
  const syncStatus = document.getElementById('sync-status');

  const urlParams = new URLSearchParams(window.location.search);
  const urlModule = urlParams.get('module');

  function setSyncStatus(message, tone = 'muted') {
    syncStatus.textContent = message;
    syncStatus.className = {
      muted: 'text-sm text-gray-500',
      success: 'text-sm text-green-600',
      error: 'text-sm text-red-600',
    }[tone];
  }

  function updateBaselineStatus() {
    if (!backendReachable) {
      setSyncStatus('Backend derzeit nicht erreichbar. Fortschritt bleibt lokal gespeichert.', 'error');
      return;
    }
    if (authMode === 'none') {
      setSyncStatus('Fortschritt wird lokal gespeichert. Für Online-Synchronisierung API-Key hinterlegen.');
      return;
    }
    if (authMode === 'valid') {
      setSyncStatus('Fortschritt lokal gespeichert und synchronisiert.', 'success');
      return;
    }
    if (authMode === 'invalid') {
      setSyncStatus('API-Key ungültig. Fortschritt bleibt lokal gespeichert.', 'error');
      return;
    }
    setSyncStatus('Fortschritt wird lokal gespeichert.');
  }

  function persistStore() {
    try {
      saveStore(window.localStorage, store);
    } catch {
      // Keep running in memory when localStorage is unavailable.
    }
  }

  function sanitizeAndPersistStore() {
    const next = sanitizeStore(store, availableSlugs);
    if (next !== store) {
      store = next;
      persistStore();
    }
  }

  function getSelectedModuleName() {
    return quizModule.value || null;
  }

  function getModuleKey(moduleName) {
    return moduleName ? (moduleKeyMap[moduleName] ?? moduleName) : ALL_MODULE_KEY;
  }

  function getCardsForModule(moduleName) {
    return moduleName ? cardData.filter(card => card.module === moduleName) : cardData;
  }

  function updateStartButtonLabel() {
    const moduleName = getSelectedModuleName();
    const moduleKey = getModuleKey(moduleName);
    const local = store.states[moduleKey];
    const canResume = Boolean(local && !local.completed);
    btnStart.textContent = canResume ? 'Fortsetzen' : 'Starten';
  }

  function deriveWrongQueue(snapshot) {
    return snapshot.queueSlugs.filter(slug => snapshot.resultsBySlug[slug] === 'wrong');
  }

  function renderCurrentCard() {
    if (!activeSnapshot) {
      emptyState.classList.remove('hidden');
      progressWrap.classList.add('hidden');
      cardWrap.classList.add('hidden');
      finishWrap.classList.add('hidden');
      updateStartButtonLabel();
      return;
    }

    const score = deriveScore(activeSnapshot.resultsBySlug);
    progressBar.style.width = `${Math.round((activeSnapshot.currentIndex / activeSnapshot.queueSlugs.length) * 100)}%`;
    progressText.textContent = `Karte ${Math.min(activeSnapshot.currentIndex + 1, activeSnapshot.queueSlugs.length)} von ${activeSnapshot.queueSlugs.length}`;
    scoreText.textContent = `✅ ${score.correct} · ❌ ${score.wrong}`;

    emptyState.classList.add('hidden');
    progressWrap.classList.remove('hidden');

    if (activeSnapshot.completed || activeSnapshot.currentIndex >= activeQueue.length) {
      cardWrap.classList.add('hidden');
      progressWrap.classList.add('hidden');
      finishWrap.classList.remove('hidden');
      const total = score.correct + score.wrong;
      const pct = total > 0 ? Math.round((score.correct / total) * 100) : 0;
      finishScore.textContent = `${score.correct} von ${total} richtig (${pct}%)`;
      const wrongSlugs = deriveWrongQueue(activeSnapshot);
      btnRetryWrong.disabled = wrongSlugs.length === 0;
      btnRetryWrong.classList.toggle('opacity-40', wrongSlugs.length === 0);
      updateStartButtonLabel();
      return;
    }

    finishWrap.classList.add('hidden');
    cardWrap.classList.remove('hidden');

    const card = activeQueue[activeSnapshot.currentIndex];
    flipped = false;
    cardInner.style.transform = '';
    ratingButtons.classList.add('hidden');
    cardQuestion.textContent = card.question;

    if (card.image) {
      cardImage.src = card.image.startsWith('http') ? card.image : `${apiBase}/api/assets/${card.image.replace(/^assets\//, '')}`;
      cardImage.alt = card.question;
      cardImage.classList.remove('hidden');
    } else {
      cardImage.src = '';
      cardImage.classList.add('hidden');
    }

    cardAnswer.innerHTML = renderMd(card.answer);

    if (card.answerImage) {
      cardAnswerImage.src = card.answerImage.startsWith('http') ? card.answerImage : `${apiBase}/api/assets/${card.answerImage.replace(/^assets\//, '')}`;
      cardAnswerImage.alt = card.answer;
      cardAnswerImage.classList.remove('hidden');
    } else {
      cardAnswerImage.src = '';
      cardAnswerImage.classList.add('hidden');
    }

    if (card.examples && card.examples.length > 0) {
      cardExamplesList.innerHTML = card.examples.map(example => `<li>${example}</li>`).join('');
      cardExamples.classList.remove('hidden');
    } else {
      cardExamples.classList.add('hidden');
    }

    updateStartButtonLabel();
  }

  function setActiveSnapshot(snapshot, options = { persist: true }) {
    const queue = restoreQueueFromSlugs(snapshot.queueSlugs, cardData);
    if (!queue) return false;
    activeSnapshot = snapshot;
    activeQueue = queue;
    if (options.persist) {
      store = setModuleSnapshot(store, snapshot);
      persistStore();
    }
    renderCurrentCard();
    return true;
  }

  function createAndStartNewSnapshot({ moduleName, previousRevision = 0, queueSlugs }) {
    const moduleKey = getModuleKey(moduleName);
    const nextQueueSlugs = queueSlugs ?? shuffle(getCardsForModule(moduleName)).map(card => card.slug);
    if (nextQueueSlugs.length === 0) {
      alert('Keine Karten für dieses Modul gefunden.');
      return null;
    }
    const snapshot = createNewSnapshot({
      moduleKey,
      moduleName,
      queueSlugs: nextQueueSlugs,
      nowIso: nowIso(),
      previousRevision,
    });
    setActiveSnapshot(snapshot);
    void syncSnapshot(snapshot);
    return snapshot;
  }

  async function checkBackendReachability() {
    const endpoint = `${apiBase.replace(/\/$/, '')}/api/health`;
    try {
      await fetch(endpoint, { method: 'GET' });
      backendReachable = true;
    } catch {
      backendReachable = false;
    }
    updateBaselineStatus();
    return backendReachable;
  }

  async function fetchRemoteSnapshot(moduleKey) {
    if (!window.fiaeAuth?.hasApiKey()) return null;
    if (!backendReachable) return null;
    if (hasPendingResetTombstone(store, moduleKey)) return null;

    try {
      const response = await window.fiaeAuth.apiFetch(`/api/quiz-state/${encodeURIComponent(moduleKey)}`);
      if (response.status === 404) return null;
      if (response.status === 401 || response.status === 403) {
        authMode = 'invalid';
        updateBaselineStatus();
        return null;
      }
      if (!response.ok) {
        setSyncStatus(`Lokaler Fortschritt gespeichert. Online-Synchronisierung fehlgeschlagen (HTTP ${response.status}).`, 'error');
        return null;
      }
      const payload = await response.json();
      if (!payload || typeof payload !== 'object') return null;
      const snapshot = payload;
      if (!validateSnapshotAgainstCards(snapshot, availableSlugs)) return null;
      return snapshot;
    } catch {
      backendReachable = false;
      updateBaselineStatus();
      return null;
    }
  }

  function toPutBody(snapshot) {
    return {
      moduleName: snapshot.moduleName,
      queueSlugs: snapshot.queueSlugs,
      currentIndex: snapshot.currentIndex,
      resultsBySlug: snapshot.resultsBySlug,
      completed: snapshot.completed,
      revision: snapshot.revision,
      startedAt: snapshot.startedAt,
    };
  }

  async function syncSnapshot(snapshot) {
    if (!window.fiaeAuth?.hasApiKey()) return;
    if (!backendReachable) return;
    if (hasPendingResetTombstone(store, snapshot.moduleKey)) return;

    const syncKey = `${snapshot.moduleKey}:${snapshot.revision}`;
    if (inFlightSyncRevisions.has(syncKey)) return;
    inFlightSyncRevisions.add(syncKey);

    try {
      const response = await window.fiaeAuth.apiFetch(`/api/quiz-state/${encodeURIComponent(snapshot.moduleKey)}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(toPutBody(snapshot)),
      });

      if (response.ok) {
        authMode = 'valid';
        updateBaselineStatus();
        return;
      }

      if (response.status === 401 || response.status === 403) {
        authMode = 'invalid';
        updateBaselineStatus();
        return;
      }

      if (response.status === 409) {
        setSyncStatus('Lokaler Fortschritt gespeichert. Online-Stand weicht ab.', 'error');
        return;
      }

      setSyncStatus(`Lokaler Fortschritt gespeichert. Online-Synchronisierung fehlgeschlagen (HTTP ${response.status}).`, 'error');
    } catch {
      backendReachable = false;
      updateBaselineStatus();
    } finally {
      inFlightSyncRevisions.delete(syncKey);
    }
  }

  async function syncPendingDeletes() {
    if (!window.fiaeAuth?.hasApiKey()) return;
    if (!backendReachable) return;

    for (const moduleKey of Object.keys(store.tombstones)) {
      if (!hasPendingResetTombstone(store, moduleKey)) continue;
      try {
        const response = await window.fiaeAuth.apiFetch(`/api/quiz-state/${encodeURIComponent(moduleKey)}`, {
          method: 'DELETE',
        });
        if (response.ok || response.status === 404) {
          store = clearResetTombstone(store, moduleKey);
          persistStore();
        } else if (response.status === 401 || response.status === 403) {
          authMode = 'invalid';
          updateBaselineStatus();
        } else {
          setSyncStatus(`Lokaler Fortschritt gespeichert. Online-Synchronisierung fehlgeschlagen (HTTP ${response.status}).`, 'error');
        }
      } catch {
        backendReachable = false;
        updateBaselineStatus();
        return;
      }
    }
  }

  async function syncWithRemoteIfNeeded(moduleKey) {
    const local = store.states[moduleKey];
    if (!local || hasPendingResetTombstone(store, moduleKey)) return;
    const remote = await fetchRemoteSnapshot(moduleKey);
    if (!remote) {
      void syncSnapshot(local);
      return;
    }

    const queue = restoreQueueFromSlugs(remote.queueSlugs ?? [], cardData);
    if (!queue) {
      void syncSnapshot(local);
      return;
    }

    const remoteSnapshot = remote;
    const relation = compareSnapshots(local, remoteSnapshot);
    if (relation === 'local-newer') {
      void syncSnapshot(local);
      return;
    }
    if (relation === 'remote-newer') {
      setActiveSnapshot(remoteSnapshot);
      authMode = 'valid';
      updateBaselineStatus();
      return;
    }
    if (relation === 'conflict') {
      setSyncStatus('Lokaler Fortschritt gespeichert. Online-Stand weicht ab.', 'error');
      return;
    }
    authMode = 'valid';
    updateBaselineStatus();
  }

  async function submitHistoricalAnswer(card, correct) {
    if (!window.fiaeAuth?.hasApiKey()) return;
    try {
      const response = await window.fiaeAuth.apiFetch(`/api/progress/${encodeURIComponent(card.slug)}/answer`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(buildHistoricalAnswerBody(correct)),
      });
      if (response.status === 401 || response.status === 403) {
        authMode = 'invalid';
        updateBaselineStatus();
      }
    } catch {
      backendReachable = false;
      updateBaselineStatus();
    }
  }

  function answerCurrentCard(correct) {
    if (!activeSnapshot) return;
    if (activeSnapshot.completed) return;
    const card = activeQueue[activeSnapshot.currentIndex];
    if (!card) return;

    const nextSnapshot = recordAnswer({
      snapshot: activeSnapshot,
      slug: card.slug,
      correct,
      nowIso: nowIso(),
    });

    setActiveSnapshot(nextSnapshot);
    void syncSnapshot(nextSnapshot);
    void submitHistoricalAnswer(card, correct);
  }

  async function restoreOrStartModule(moduleName) {
    const moduleKey = getModuleKey(moduleName);
    const local = store.states[moduleKey];
    if (local) {
      setActiveSnapshot(local);
      await syncWithRemoteIfNeeded(moduleKey);
      return;
    }

    if (hasPendingResetTombstone(store, moduleKey)) {
      createAndStartNewSnapshot({ moduleName });
      return;
    }

    if (window.fiaeAuth?.hasApiKey() && backendReachable) {
      const remote = await fetchRemoteSnapshot(moduleKey);
      if (remote) {
        setActiveSnapshot(remote);
        return;
      }
    }

    createAndStartNewSnapshot({ moduleName });
  }

  async function restartActiveQuiz() {
    if (!activeSnapshot) return;
    const moduleName = activeSnapshot.moduleName;
    const moduleKey = activeSnapshot.moduleKey;
    const previousRevision = activeSnapshot.revision;
    store = removeModuleSnapshot(store, moduleKey);
    store = markResetTombstone(store, moduleKey, nowIso());
    persistStore();
    createAndStartNewSnapshot({ moduleName, previousRevision });
    await syncPendingDeletes();
    if (!hasPendingResetTombstone(store, moduleKey) && activeSnapshot) {
      void syncSnapshot(activeSnapshot);
    }
  }

  function retryWrongCards() {
    if (!activeSnapshot) return;
    const wrongSlugs = deriveWrongQueue(activeSnapshot);
    if (wrongSlugs.length === 0) return;
    createAndStartNewSnapshot({
      moduleName: activeSnapshot.moduleName,
      previousRevision: activeSnapshot.revision,
      queueSlugs: wrongSlugs,
    });
  }

  function restoreLastActiveState() {
    const moduleKey = store.lastActiveModuleKey;
    if (!moduleKey) return false;
    const snapshot = store.states[moduleKey];
    if (!snapshot) return false;
    if (!setActiveSnapshot(snapshot, { persist: false })) return false;
    if (snapshot.moduleName) {
      const match = Array.from(quizModule.options).find(option => option.value === snapshot.moduleName);
      if (match) match.selected = true;
    } else {
      quizModule.value = '';
    }
    return true;
  }

  function restoreSelectedModuleFromUrl() {
    if (!urlModule) return;
    const option = Array.from(quizModule.options).find(entry => entry.value === urlModule);
    if (option) option.selected = true;
    return option?.value ?? null;
  }

  async function initializeQuizState() {
    store = loadStore(window.localStorage);
    sanitizeAndPersistStore();
    const requestedModuleName = restoreSelectedModuleFromUrl();
    const restoredLastActive = requestedModuleName ? false : restoreLastActiveState();
    if (!restoredLastActive && !requestedModuleName) renderCurrentCard();
    await checkBackendReachability();
    await syncPendingDeletes();
    if (requestedModuleName) {
      await restoreOrStartModule(requestedModuleName);
    } else if (restoredLastActive && activeSnapshot) {
      await syncWithRemoteIfNeeded(activeSnapshot.moduleKey);
    }
    updateStartButtonLabel();
  }

  flipCard.addEventListener('click', () => {
    if (!flipped) {
      flipped = true;
      cardInner.style.transform = 'rotateY(180deg)';
      ratingButtons.classList.remove('hidden');
    }
  });

  btnCorrect.addEventListener('click', () => answerCurrentCard(true));

  btnWrong.addEventListener('click', () => answerCurrentCard(false));

  btnStart.addEventListener('click', async () => {
    await restoreOrStartModule(getSelectedModuleName());
  });

  quizModule.addEventListener('change', updateStartButtonLabel);
  btnRetryWrong.addEventListener('click', retryWrongCards);
  btnRestart.addEventListener('click', () => {
    void restartActiveQuiz();
  });

  window.addEventListener('fiae:auth-changed', (event) => {
    const detail = event.detail ?? {};
    if (!detail.apiKey) {
      authMode = 'none';
      updateBaselineStatus();
      return;
    }
    authMode = detail.authenticated ? 'valid' : 'invalid';
    updateBaselineStatus();
    if (detail.authenticated) {
      void checkBackendReachability().then(async (reachable) => {
        if (!reachable) return;
        await syncPendingDeletes();
        if (activeSnapshot) {
          await syncWithRemoteIfNeeded(activeSnapshot.moduleKey);
        }
      });
    }
  });

  window.addEventListener('online', () => {
    void checkBackendReachability().then(async (reachable) => {
      if (!reachable) return;
      await syncPendingDeletes();
      if (activeSnapshot) {
        await syncWithRemoteIfNeeded(activeSnapshot.moduleKey);
      }
    });
  });

  void initializeQuizState();
</script>
