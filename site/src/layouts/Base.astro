---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { 
  title = 'FIAE Lernsystem für Fachinformatiker', 
  description = 'Interaktives Lernsystem zur Vorbereitung auf die Prüfungen für Fachinformatiker'
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const apiBase = import.meta.env.PUBLIC_API_BASE;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 flex flex-col" data-api-base={apiBase}>
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm">
      <nav class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2 sm:gap-x-6">
        <a href={`${base}/`} class="text-lg font-bold text-blue-700 hover:text-blue-900">FIAE Lernsystem</a>
        <a href={`${base}/cards`} class="text-sm text-gray-600 hover:text-blue-700 transition-colors">Alle Karten</a>
        <a href={`${base}/modules`} class="text-sm text-gray-600 hover:text-blue-700 transition-colors">Module</a>
        <a href={`${base}/quiz`} class="text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-3 py-1.5 rounded-lg transition-colors ml-auto">Quiz starten</a>
      </nav>
      <div class="border-t border-gray-100">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col lg:flex-row lg:items-center gap-2 lg:gap-3">
          <label for="api-key-input" class="text-xs font-semibold uppercase tracking-wide text-gray-500 shrink-0">API Key</label>
          <input
            id="api-key-input"
            type="password"
            placeholder="Backend API-Key"
            autocomplete="off"
            spellcheck="false"
            class="w-full lg:max-w-sm border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <div class="flex items-center gap-2">
            <button id="api-key-save" type="button" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-3 py-2 rounded-lg transition-colors">
              Speichern
            </button>
            <button id="api-key-clear" type="button" class="bg-white border border-gray-300 hover:bg-gray-50 text-sm font-semibold px-3 py-2 rounded-lg transition-colors">
              Löschen
            </button>
          </div>
          <span id="api-key-status" class="text-xs text-gray-500 lg:ml-2">Kein API-Key gespeichert.</span>
        </div>
      </div>
    </header>
    <main class="flex-1 max-w-6xl mx-auto w-full px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-gray-200 text-center text-xs text-gray-400 py-4">
      AP1 Lernsystem · {new Date().getFullYear()}
    </footer>
    <script>
      import { initAuthUi } from '../lib/client-auth';

      initAuthUi();
    </script>
  </body>
</html>
